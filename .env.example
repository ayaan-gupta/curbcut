# Copy to .env to change anything. Every value here is the default.

# Ports (host side). All three are published on 127.0.0.1 only.
CURBCUT_WEB_PORT=4109
CURBCUT_API_PORT=8109
CURBCUT_DB_PORT=5509

# PostGIS. The password is a local development default, not a secret. Change it for anything shared.
CURBCUT_DB_PASSWORD=curbcut
POSTGIS_IMAGE=imresamu/postgis:17-3.5
# Used by the API when it runs outside Docker (make dev). Leave empty for the in-memory store.
CURBCUT_DATABASE_URL=postgresql://curbcut:curbcut@localhost:5509/curbcut

# API behaviour
CURBCUT_SEED_DEMO=true            # seed clearly labelled synthetic demo reports into an empty database
CURBCUT_REVIEWER_TOKEN=           # empty leaves the review and export endpoints open, which is only sensible on localhost
CURBCUT_DEVICE_SALT=curbcut-dev-salt
CURBCUT_PUBLISH_THRESHOLD=0.5
CURBCUT_EXPORT_THRESHOLD=0.6
CURBCUT_CLUSTER_RADIUS_M=5
CURBCUT_RATE_LIMIT_10MIN=40
CURBCUT_RATE_LIMIT_DAY=400
CURBCUT_MAX_ACCURACY_M=25
CURBCUT_MAX_SPEED_MPS=12
CURBCUT_UPLOAD_DIR=data/uploads

# Web. A keyless MapLibre style URL, or "offline" for the built-in basemap drawn from the committed OSM extract.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# Tests: store-backed tests also run on PostGIS when this is set (make test sets it).
CURBCUT_TEST_DATABASE_URL=postgresql://curbcut:curbcut@localhost:5509/curbcut_test
