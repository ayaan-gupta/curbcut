{
  "name": "curbcut-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Curbcut PWA: record a walk, photograph a curb, see the map, route around barriers.",
  "scripts": {
    "dev": "vite --port ${CURBCUT_WEB_PORT:-4109} --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port ${CURBCUT_WEB_PORT:-4109} --strictPort",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "art": "tsx scripts/build-art.ts",
    "e2e": "tsx scripts/e2e.ts",
    "demo": "tsx scripts/record-demo.ts"
  },
  "dependencies": {
    "maplibre-gl": "^4.7.1",
    "onnxruntime-web": "^1.20.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.14",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "gifenc": "^1.0.3",
    "onnxruntime-node": "^1.20.1",
    "playwright": "^1.48.0",
    "sharp": "^0.33.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
